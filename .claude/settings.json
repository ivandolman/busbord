{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(./data/**)",
            "Read(./.next/**)",
            "Read(./dist/**)",
            "Read(./pnpm-lock.yaml)",
            "Read(./tsconfig.tsbuildinfo)",
            "Read(./next-env.d.ts)",
            "Read(./public/map-styles/**)",
            "Read(./.idea/**)",
            "Read(./.env)",
            "Read(./.env.local)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-code-map.sh"
                    }
                ]
            }
        ]
    }
}
