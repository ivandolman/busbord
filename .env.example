# Static timetable. Open data (CC0), country-wide, a few hundred MB.
GTFS_URL=https://gtfs.ovapi.nl/nl/gtfs-nl.zip
GTFS_DB_PATH=data/gtfs.sqlite

# Region kept by the importer: minLat,minLon,maxLat,maxLon (default = province of Utrecht).
GTFS_BBOX=51.90,4.75,52.32,5.65

# Road network for drawing lines along the street ("pnpm roads:import"). Comma-separated
# OpenStreetMap extracts that together cover GTFS_BBOX; the default is Utrecht and its neighbours.
# OSM_EXTRACTS=https://download.geofabrik.de/europe/netherlands/utrecht-latest.osm.pbf
ROADS_PATH=data/roads.bin

# Realtime trip updates (GTFS-RT). Set GTFS_RT_ENABLED=false to run on the timetable only.
GTFS_RT_ENABLED=true
GTFS_RT_URL=https://gtfs.ovapi.nl/nl/tripUpdates.pb

# Sent with every request to the data provider so they can reach you. Use a project URL or
# a role address; do not put a personal address here if the repo is public.
OVAPI_USER_AGENT=bestemmingsbord-prototype
