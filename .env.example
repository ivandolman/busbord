# Static timetable. Open data (CC0), country-wide, a few hundred MB.
GTFS_URL=https://gtfs.ovapi.nl/nl/gtfs-nl.zip
GTFS_DB_PATH=data/gtfs.sqlite

# Region kept by the importer: minLat,minLon,maxLat,maxLon (default = province of Utrecht, west to Gouda).
GTFS_BBOX=51.90,4.60,52.32,5.65

# Road network for drawing lines along the street ("pnpm roads:import"). Comma-separated
# OpenStreetMap extracts that together cover GTFS_BBOX; the default is Utrecht and its neighbours.
# OSM_EXTRACTS=https://download.geofabrik.de/europe/netherlands/utrecht-latest.osm.pbf
ROADS_PATH=data/roads.bin

# Realtime trip updates (GTFS-RT). Set GTFS_RT_ENABLED=false to run on the timetable only.
GTFS_RT_ENABLED=true
GTFS_RT_URL=https://gtfs.ovapi.nl/nl/tripUpdates.pb

# Sent with every request to the data provider so they can reach you. Use a project URL or
# a role address; do not put a personal address here if the repo is public.
OVAPI_USER_AGENT=bestemmingsbord-prototype

# Login. One shared password for the whole app (pages and API). Without it the app is open in
# development and refuses to start serving in production. AUTH_SECRET (optional, a long random
# string) signs the session cookies; without it they are signed with the password, so changing
# the password logs everyone out. AUTH_DISABLED=true runs without a login on purpose, e.g.
# behind a reverse proxy that already authenticates.
AUTH_PASSWORD=
# AUTH_SECRET=
# AUTH_DISABLED=false

# Docker/Coolify only: what the container does with the timetable on start.
# missing (default) = import when data/gtfs.sqlite is absent, always = on every start,
# demo = the invented demo timetable, never = leave it to you / a scheduled task.
# GTFS_IMPORT_ON_START=missing
