{
    "name": "busbord",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.13"
    },
    "packageManager": "pnpm@10.28.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --experimental-test-module-mocks --import tsx --test \"src/**/!(*.integration).tests.ts\"",
        "test:integration": "node --experimental-test-module-mocks --import tsx --test \"src/**/*.integration.tests.ts\"",
        "gtfs:import": "tsx --env-file-if-exists=.env scripts/import-gtfs.ts",
        "roads:import": "tsx --env-file-if-exists=.env scripts/import-roads.ts",
        "gtfs:demo": "tsx --env-file-if-exists=.env scripts/make-demo-feed.ts",
        "build:scripts": "esbuild scripts/import-gtfs.ts scripts/import-roads.ts scripts/make-demo-feed.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist/scripts --out-extension:.js=.mjs --packages=bundle --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "gtfs-realtime-bindings": "^2.2.0",
        "leaflet": "^1.9.4",
        "next": "^16.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "yauzl": "^3.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@tailwindcss/postcss": "^4.3.5",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/yauzl": "^3.4.0",
        "@types/yazl": "^3.3.1",
        "esbuild": "0.28.2",
        "eslint": "^10.14.0",
        "eslint-config-next": "^16.4.6",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.5",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "yazl": "^3.3.1"
    }
}
