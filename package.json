{
  "name": "bestemmingsbord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gtfs:import": "tsx --env-file-if-exists=.env scripts/import-gtfs.ts",
    "roads:import": "tsx --env-file-if-exists=.env scripts/import-roads.ts",
    "gtfs:demo": "tsx --env-file-if-exists=.env scripts/make-demo-feed.ts",
    "build:scripts": "esbuild scripts/import-gtfs.ts scripts/import-roads.ts scripts/make-demo-feed.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist/scripts --out-extension:.js=.mjs --packages=bundle --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "gtfs-realtime-bindings": "^2.2.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "yazl": "^3.3.1"
  }
}
